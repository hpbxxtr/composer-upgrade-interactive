{
  "name": "hpbxxtr/composer-upgrade-interactive",
  "description": "Interactive TUI for selectively upgrading Composer dependencies (yarn upgrade-interactive for PHP)",
  "keywords": ["composer", "composer-plugin", "interactive", "upgrade", "update", "outdated", "dependencies", "cli", "php", "yarn", "semver", "tui", "laravel-prompts", "packagist"],
  "type": "composer-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Hagen Pommer",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/hpbxxtr/composer-upgrade-interactive",
  "support": {
    "issues": "https://github.com/hpbxxtr/composer-upgrade-interactive/issues",
    "source": "https://github.com/hpbxxtr/composer-upgrade-interactive"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.3",
    "composer-plugin-api": "^2.0",
    "laravel/prompts": "^0.3.16"
  },
  "require-dev": {
    "brnshkr/config": "dev-php83",
    "composer/composer": "2.9.5",
    "friendsofphp/php-cs-fixer": "3.94.2",
    "kubawerlos/php-cs-fixer-custom-fixers": "3.36.1",
    "mockery/mockery": "1.6.12",
    "pestphp/pest": "4.4.6",
    "pestphp/pest-plugin-arch": "4.0.0",
    "phpstan/extension-installer": "1.4.3",
    "phpstan/phpstan": "2.1.46",
    "phpstan/phpstan-deprecation-rules": "2.0.4",
    "phpstan/phpstan-doctrine": "2.0.20",
    "phpstan/phpstan-phpunit": "2.0.16",
    "phpstan/phpstan-strict-rules": "2.0.10",
    "phpstan/phpstan-symfony": "2.0.15",
    "phpstan/phpstan-webmozart-assert": "2.0.0",
    "rector/rector": "2.4.1",
    "rector/type-perfect": "2.1.2",
    "symfony/finder": "7.4.8",
    "symplify/phpstan-rules": "14.9.11",
    "ticketswap/phpstan-error-formatter": "1.3.0"
  },
  "autoload": {
    "psr-4": {
      "Hpbxxtr\\UpgradeInteractive\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hpbxxtr\\UpgradeInteractive\\Tests\\": "tests/"
    }
  },
  "extra": {
    "class": "Hpbxxtr\\UpgradeInteractive\\Plugin"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/GALHP/config"
    }
  ],
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "brnshkr/config": true,
      "phpstan/extension-installer": true
    }
  }
}
